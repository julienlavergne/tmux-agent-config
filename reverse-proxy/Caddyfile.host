{
	admin localhost:2019
}

http://julien-desktop-meshnet {
	@meshnet remote_ip 100.64.0.0/10
	handle @meshnet {
		reverse_proxy host.docker.internal:8000
	}
	respond "Meshnet access only" 403
}

julienlavergne.asuscomm.com {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	import /etc/caddy/routes/web/*.caddy
	handle {
		reverse_proxy host.docker.internal:8000
	}
}

https://julienlavergne.asuscomm.com:8765 {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	reverse_proxy host.docker.internal:8765
}
