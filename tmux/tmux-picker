#!/usr/bin/env bash
# ~/.local/bin/tmux-picker
# tmux session picker (executable), invoked by the login hook in ~/.profile.
# Uses fzf when available for a fuzzy-search UI; falls back to a plain
# numbered menu (pure bash + tmux, no external deps) when it isn't.
# Both paths write the same protocol to RESULT_FILE, so the caller in
# ~/.profile doesn't need to know which one ran:
#   bash            -> just drop into a plain shell
#   new:<name>      -> tmux new-session -A -s <name>  (the -A also covers
#                       "name happens to match an existing session")
#   tmux:<name>     -> tmux attach-session -t <name>
#
# Subcommands (used internally, by fzf's del binding and by the plain menu):
#   --list            print the item list and exit
#   --delete NAME     kill a tmux session and exit
#
# Item lines are "key|display". A literal '|' delimiter, not tab: without a
# UTF-8 locale (common on a minimal box — exactly where fzf is also likely
# missing) tmux's -F engine silently substitutes '_' for tab characters,
# which would corrupt the split. '|' isn't a control character so it survives
# regardless of locale, and tmux session names can't contain it anyway.

_reltime() {
    local ts=${1:-0} now diff
    now=$(date +%s); diff=$((now - ts))
    if   ((ts == 0));         then printf 'never'
    elif ((diff <    60));    then printf 'just now'
    elif ((diff <  3600));    then printf '%dm ago'  $((diff/60))
    elif ((diff < 86400));    then printf '%dh ago'  $((diff/3600))
    else                           printf '%dd ago'  $((diff/86400))
    fi
}

_list() {
    local ts attached name
    printf '__BASH__|Just enter bash\n'
    while IFS='|' read -r ts attached name; do
        [[ -z "$name" || "$attached" != "0" ]] && continue
        printf '%s|%s  (%s)\n' "$name" "$name" "$(_reltime "$ts")"
    done < <(
        tmux list-sessions \
            -F "#{?session_last_attached,#{session_last_attached},0}|#{session_attached}|#{session_name}" \
            2>/dev/null | sort -rn
    )
}

case "${1:-}" in
    --list)
        _list
        exit 0
        ;;
    --delete)
        name="${2:-}"
        [[ -n "$name" && "$name" != __* ]] && tmux kill-session -t "$name" 2>/dev/null
        exit 0
        ;;
esac

# ── plain (no-fzf) picker ───────────────────────────────────────────────────
#
# Same list, same sort order, same result-file contract as the fzf picker
# below. Instead of fuzzy search: a numbered menu. Enter with nothing typed
# picks the highlighted-by-default top entry (__BASH__), matching fzf's
# empty-query-Enter behavior. Typing a number attaches that entry. Typing
# "d N" deletes entry N and redraws, matching fzf's del binding. Anything
# else typed is treated as a new session name to create.

_pick_plain() {
    local result_file="$1" items name key num reply line i

    while true; do
        mapfile -t items < <(_list)

        echo
        i=1
        for line in "${items[@]}"; do
            printf '  %2d) %s\n' "$i" "${line#*|}"
            ((i++))
        done
        echo
        printf '  Enter=bash · number=attach · name=create · d N=delete\n'
        read -r -p '  > ' reply

        if [[ -z "$reply" ]]; then
            printf 'bash' > "$result_file"
            return
        fi

        if [[ "$reply" =~ ^[Dd][[:space:]]+([0-9]+)$ ]]; then
            num="${BASH_REMATCH[1]}"
            if ((num >= 1 && num <= ${#items[@]})); then
                key="${items[$((num-1))]%%|*}"
                [[ "$key" != __* ]] && tmux kill-session -t "$key" 2>/dev/null
            fi
            continue
        fi

        if [[ "$reply" =~ ^[0-9]+$ ]] && ((reply >= 1 && reply <= ${#items[@]})); then
            key="${items[$((reply-1))]%%|*}"
            if [[ "$key" == __* ]]; then
                printf 'bash' > "$result_file"
            else
                printf 'tmux:%s' "$key" > "$result_file"
            fi
            return
        fi

        printf 'new:%s' "$reply" > "$result_file"
        return
    done
}

# ── main picker ───────────────────────────────────────────────────────────────

result_file="${1:?Usage: tmux-picker RESULT_FILE}"
script="$HOME/.local/bin/tmux-picker"

if ! command -v fzf &>/dev/null; then
    _pick_plain "$result_file"
    exit 0
fi

output=$(
    _list | fzf \
        --no-sort \
        --print-query \
        --layout=reverse \
        --delimiter='|' \
        --with-nth=2 \
        --header='  ↑↓ navigate  ·  Enter select  ·  Del delete  ·  Type name to create' \
        --prompt='  ❯ ' \
        --bind="del:execute-silent($script --delete {1})+reload($script --list)" \
        --color='header:italic'
) || true  # fzf exits 130 on Ctrl-C / Esc — treat as "bash"

query=$(head -1  <<< "$output")
selected=$(tail -n +2 <<< "$output")
key=$(cut -d'|' -f1 <<< "${selected:-}")

case "$key" in
    ''|__BASH__)
        # No session selected — create one if user typed a name
        if [[ -n "$query" ]]; then
            printf 'new:%s' "$query" > "$result_file"
        else
            printf 'bash' > "$result_file"
        fi
        ;;
    *)
        printf 'tmux:%s' "$key" > "$result_file"
        ;;
esac
