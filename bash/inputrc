# Tab completion: cycle through options instead of listing all
TAB: menu-complete
# Shift+Tab to cycle backwards
"\e[Z": menu-complete-backward
# Show common prefix before cycling
set menu-complete-display-prefix on

# Disable bell on completion errors
set bell-style none

# Enable history search with arrow keys
# When you type part of a command and press up/down,
# it will search through history for commands starting with what you typed
"\e[A": history-search-backward
"\e[B": history-search-forward

# Enable case-insensitive completion
set completion-ignore-case on

# Show all autocomplete results at once
set page-completions off

# Show matches on first tab (useful with menu-complete)

# Add trailing slash to directory completions
set mark-directories on
set mark-symlinked-directories on

# Enable colored completion
set colored-stats on
set colored-completion-prefix on

# Show file type indicators (*/=>@|)
set visible-stats on
