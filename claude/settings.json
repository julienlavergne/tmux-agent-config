{
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(cargo *)",
      "Bash(rustup *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(uv *)",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(clang*)",
      "Bash(gcc *)",
      "Bash(g++ *)",
      "Bash(make *)",
      "Bash(cmake *)",
      "Bash(ninja *)",
      "Bash(docker build*)",
      "Bash(docker run *)",
      "Bash(docker exec *)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker inspect*)",
      "Bash(docker images*)",
      "Bash(docker pull *)",
      "Bash(docker compose *)",
      "Bash(docker-compose *)",
      "Bash(docker network *)",
      "Bash(docker volume *)",
      "Bash(tmux *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(fd *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(patch *)",
      "Bash(tar *)",
      "Bash(zip *)",
      "Bash(unzip *)",
      "Bash(gzip *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(ln *)",
      "Bash(ps *)",
      "Bash(lsof *)",
      "Bash(ss *)",
      "Bash(ip *)",
      "Bash(ping *)",
      "Bash(env *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(uname *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(free *)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker stop *)",
      "Bash(docker kill *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(snap *)",
      "Bash(dpkg *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/claude-cli-status/statusline.sh"
  },
  "enabledPlugins": {
    "docker-development@claude-code-skills": true
  },
  "extraKnownMarketplaces": {
    "claude-code-skills": {
      "source": {
        "source": "github",
        "repo": "alirezarezvani/claude-skills"
      }
    }
  },
  "theme": "dark",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
