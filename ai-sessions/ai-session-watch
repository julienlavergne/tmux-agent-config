#!/bin/bash
# Unified AI session watcher — maintains a named tmux pane for claude or copilot.

NAME="$1"
CWD="$2"
AGENT="$3"

# Seconds of tmux inactivity before the pane is respawned to refresh the
# remote connection.  Set IDLE_TIMEOUT=0 in the session's .env to disable.
IDLE_TIMEOUT="${IDLE_TIMEOUT:-21600}"  # default: 6 hours

CLAUDE="${HOME}/.local/bin/claude"
COPILOT="${HOME}/.local/bin/copilot"
DB="${HOME}/.copilot/session-store.db"
PROJECT_DIR="${HOME}/.claude/projects/$(echo "${CWD}" | sed 's|/|-|g')"

make_claude_cmd() {
    # Resolve to the exact session ID of the most recent transcript with this
    # customTitle, so --resume never hits the picker even when multiple past
    # sessions (e.g. from /reset) share the same name. --fork-session branches
    # a fresh session ID off that transcript instead of attaching directly, so
    # a respawn never collides with the same session still running as a
    # background agent elsewhere (e.g. attached via Remote Control/FleetView).
    local session_id
    session_id=$(grep -l "\"customTitle\":\"${NAME}\"" "${PROJECT_DIR}"/*.jsonl 2>/dev/null \
        | xargs -r ls -t 2>/dev/null \
        | head -1 \
        | xargs -r basename -s .jsonl)
    if [[ -n "${session_id}" ]]; then
        echo "${CLAUDE} --name ${NAME} --resume ${session_id} --fork-session --rc ${NAME}"
    else
        echo "${CLAUDE} --name ${NAME} --rc ${NAME}"
    fi
}

make_copilot_cmd() {
    local count
    count=$(sqlite3 "${DB}" \
        "SELECT COUNT(*) FROM session_refs WHERE ref_type='name' AND ref_value='${NAME}'" \
        2>/dev/null)
    if [[ "${count}" -gt 0 ]]; then
        echo "${COPILOT} --yolo --resume=${NAME} --remote"
    else
        echo "${COPILOT} --yolo --name ${NAME} --remote"
    fi
}

make_cmd() {
    case "${AGENT}" in
        claude)  make_claude_cmd ;;
        copilot) make_copilot_cmd ;;
    esac
}

# "=NAME" forces an exact session-name match. Without it, tmux target lookup
# matches on prefix, so e.g. "desktop-x-claude" would silently match an
# already-running "desktop-x-claude-2" and this script would believe its own
# session already exists — skipping creation and monitoring the wrong pane.
if ! tmux has-session -t "=${NAME}" 2>/dev/null; then
    tmux new-session -d -s "${NAME}" -c "${CWD}" "$(make_cmd)"
    tmux set-window-option -t "${NAME}" remain-on-exit on
fi

# Baseline for idle measurement. respawn-pane does not advance
# #{session_activity}, so idleness is measured from the later of real client
# activity and our own last respawn — otherwise a genuinely idle, detached
# session crosses the threshold and respawns on every loop, tearing down its
# remote connection every few seconds.
last_respawn=$(date +%s)

respawn() {
    tmux respawn-pane -t "=${NAME}:0" -k "$(make_cmd)"
    last_respawn=$(date +%s)
}

while tmux has-session -t "=${NAME}" 2>/dev/null; do
    if [[ "$(tmux display-message -t "=${NAME}:0" -p '#{pane_dead}')" == "1" ]]; then
        sleep 60
        respawn
    elif [[ "${IDLE_TIMEOUT}" -gt 0 ]]; then
        # A live client (e.g. mobile Remote Control) means the session is in
        # use; refreshing the pane now is exactly what drops the connection.
        if [[ "$(tmux display-message -t "${NAME}" -p '#{session_attached}')" -gt 0 ]]; then
            sleep 5
            continue
        fi
        last_activity=$(tmux display-message -t "${NAME}" -p '#{session_activity}')
        [[ "${last_respawn}" -gt "${last_activity}" ]] && last_activity="${last_respawn}"
        idle_secs=$(( $(date +%s) - last_activity ))
        if [[ "${idle_secs}" -gt "${IDLE_TIMEOUT}" ]]; then
            logger -t ai-session-watch "${NAME}: idle ${idle_secs}s > ${IDLE_TIMEOUT}s, respawning"
            respawn
        fi
    fi
    sleep 5
done
