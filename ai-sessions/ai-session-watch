#!/bin/bash
# Unified AI session watcher — maintains a named tmux pane for claude or copilot.

NAME="$1"
CWD="$2"
AGENT="$3"

CLAUDE="${HOME}/.local/bin/claude"
COPILOT="${HOME}/.local/bin/copilot"
DB="${HOME}/.copilot/session-store.db"
PROJECT_DIR="${HOME}/.claude/projects/$(echo "${CWD}" | sed 's|/|-|g')"

make_claude_cmd() {
    # Resolve to the exact session ID of the most recent transcript with this
    # customTitle, so --resume attaches to the SAME session every time (stable
    # id, one persistent Remote Control entry) and never hits the picker even
    # when several past transcripts share the name.
    #
    # NOTE: intentionally NO --fork-session. Forking rotated the session id on
    # every respawn, which piled up a fresh Remote Control window per day.
    # Resuming in place keeps a single persistent session with --rc enabled.
    # Trade-off: never run a second agent (e.g. a cloud/FleetView background
    # agent) that continues this same session id while the local pane is live,
    # or both would append to the same transcript.
    local session_id
    session_id=$(grep -l "\"customTitle\":\"${NAME}\"" "${PROJECT_DIR}"/*.jsonl 2>/dev/null \
        | xargs -r ls -t 2>/dev/null \
        | head -1 \
        | xargs -r basename -s .jsonl)
    if [[ -n "${session_id}" ]]; then
        echo "${CLAUDE} --name ${NAME} --resume ${session_id} --rc ${NAME}"
    else
        echo "${CLAUDE} --name ${NAME} --rc ${NAME}"
    fi
}

make_copilot_cmd() {
    local count
    count=$(sqlite3 "${DB}" \
        "SELECT COUNT(*) FROM session_refs WHERE ref_type='name' AND ref_value='${NAME}'" \
        2>/dev/null)
    if [[ "${count}" -gt 0 ]]; then
        echo "${COPILOT} --yolo --resume=${NAME} --remote"
    else
        echo "${COPILOT} --yolo --name ${NAME} --remote"
    fi
}

make_cmd() {
    case "${AGENT}" in
        claude)  make_claude_cmd ;;
        copilot) make_copilot_cmd ;;
    esac
}

# "=NAME" forces an exact session-name match. Without it, tmux target lookup
# matches on prefix, so e.g. "desktop-x-claude" would silently match an
# already-running "desktop-x-claude-2" and this script would believe its own
# session already exists — skipping creation and monitoring the wrong pane.
if ! tmux has-session -t "=${NAME}" 2>/dev/null; then
    tmux new-session -d -s "${NAME}" -c "${CWD}" "$(make_cmd)"
    tmux set-window-option -t "${NAME}" remain-on-exit on
fi

while tmux has-session -t "=${NAME}" 2>/dev/null; do
    if [[ "$(tmux display-message -t "=${NAME}:0" -p '#{pane_dead}')" == "1" ]]; then
        sleep 60
        tmux respawn-pane -t "=${NAME}:0" -k "$(make_cmd)"
    fi
    sleep 5
done
