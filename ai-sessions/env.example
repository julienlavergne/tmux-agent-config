# Copy to ~/.config/ai-sessions/<device>-<foldername>-<agent>.env
# e.g. ~/.config/ai-sessions/desktop-home-claude.env
#
# CWD: absolute path the session starts in (also determines <foldername>)
# AGENT: claude | copilot | codex
# NETWORK_NAMESPACE: host (default) | agent-vpn (Claude/Codex only; requires the tunnel to be active)

CWD=/home/YOUR_USER/workspace/YOUR_PROJECT
AGENT=claude
# NETWORK_NAMESPACE=host
