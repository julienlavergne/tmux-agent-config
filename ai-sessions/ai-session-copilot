#!/usr/bin/env python3
"""Resume the foreground Copilot conversation belonging to one AI service."""
import json
import os
from pathlib import Path
import re
import signal
import sqlite3
import subprocess
import sys
import tempfile
import time

FOREGROUND = re.compile(r'\[INFO\] Registering foreground session: ([0-9a-f-]{36})\s*$')


def foreground(line):
    match = FOREGROUND.search(line)
    return match.group(1) if match else None


def metadata(path):
    values = {}
    for line in path.read_text().splitlines():
        key, sep, value = line.partition(':')
        if sep:
            value = value.strip()
            if value.startswith('"'):
                value = json.loads(value)
            elif value.startswith("'") and value.endswith("'"):
                value = value[1:-1].replace("''", "'")
            values[key] = value
    return values


def resolve(root, mapping, name, cwd):
    if mapping.exists():
        session = mapping.read_text().strip()
        if not re.fullmatch(r'[0-9a-f-]{36}', session):
            raise RuntimeError('Invalid saved Copilot session ID')
        workspace = root / 'session-state' / session / 'workspace.yaml'
        if not workspace.exists():
            raise RuntimeError('Saved Copilot conversation is missing; refusing to replace it')
        return session
    db = root / 'session-store.db'
    if db.exists():
        with sqlite3.connect(f'file:{db}?mode=ro', uri=True) as conn:
            ids = [row[0] for row in conn.execute(
                'SELECT id FROM sessions WHERE cwd=? ORDER BY updated_at DESC', (cwd,))]
        for session in ids:
            path = root / 'session-state' / session / 'workspace.yaml'
            if path.exists() and metadata(path).get('name', '').casefold() == name.casefold():
                return session
    return None


def main():
    name, cwd = sys.argv[1:]
    root = Path.home() / '.copilot'
    state = Path.home() / '.local/state/ai-sessions'
    state.mkdir(parents=True, exist_ok=True)
    mapping = state / (name + '.copilot-id')
    session = resolve(root, mapping, name, cwd)
    # Isolate process logs so another service or older launch cannot affect us.
    log_root = state / (name + '.copilot-logs')
    log_root.mkdir(exist_ok=True)
    logs = Path(tempfile.mkdtemp(prefix='run-', dir=log_root))
    def persist(session_id):
        temp = mapping.with_suffix('.tmp')
        temp.write_text(session_id + '\n')
        temp.replace(mapping)
    cmd = [str(Path.home() / '.local/bin/copilot'), '--yolo', '--remote',
           '-C', cwd, '--log-dir', str(logs), '--log-level', 'info']
    if session:
        persist(session)
        cmd += ['--resume=' + session]
    else:
        cmd += ['--name', name]
    if session:
        # tmux's kill-session returns before the previous CLI finishes exiting.
        workspace = root / 'session-state' / session
        for attempt in range(40):
            live = False
            for hold in workspace.glob('inuse.*.hold'):
                try:
                    pid = int(hold.name.split('.')[1])
                    os.kill(pid, 0)
                    live = True
                except (ValueError, ProcessLookupError):
                    pass
            if not live:
                break
            time.sleep(0.25)
        else:
            raise RuntimeError('Saved Copilot conversation is still in use by another process')
    child = subprocess.Popen(cmd)
    def forward(signum, frame):
        child.send_signal(signum)
    signal.signal(signal.SIGTERM, forward)
    signal.signal(signal.SIGINT, forward)
    offsets = {}
    def update():
        nonlocal session
        for path in sorted(logs.glob('process-*.log'), key=lambda p: p.stat().st_mtime_ns):
            with path.open() as stream:
                stream.seek(offsets.get(path, 0))
                while True:
                    position = stream.tell()
                    line = stream.readline()
                    if not line or not line.endswith('\n'):
                        stream.seek(position)
                        break
                    current = foreground(line)
                    if current and current != session:
                        workspace = root / 'session-state' / current / 'workspace.yaml'
                        if not workspace.exists():
                            stream.seek(position)
                            break
                        persist(current)
                        session = current
                offsets[path] = stream.tell()
    while child.poll() is None:
        update()
        time.sleep(5)
    update()
    sys.exit(child.wait())


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, sqlite3.Error) as exc:
        print(f'AI session resume error: {exc}', file=sys.stderr)
        sys.exit(1)
